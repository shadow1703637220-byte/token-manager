#!/bin/zsh
# 本地 Token 管家（发行版）· App 启动器
# 用包内自带的 node 跑包内 server.js；数据自动存到 ~/Library/Application Support/TokenManager/data.json
SELF="${0:A:h}"
RES="$SELF/../Resources"
PORT=3210
URL="http://127.0.0.1:${PORT}/"

if ! curl -s -o /dev/null --max-time 2 "$URL"; then
  TM_DIST=1 TM_NO_BROWSER=1 nohup "$RES/node" "$RES/server.js" >> "$HOME/Library/Logs/TokenManager.log" 2>&1 &
  for i in {1..40}; do
    curl -s -o /dev/null --max-time 1 "$URL" && break
    sleep 0.25
  done
fi

APPURL="${URL}?t=$(date +%s)"
if [ -d "/Applications/Google Chrome.app" ]; then
  "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" --app="$APPURL" >/dev/null 2>&1 &
else
  open "$APPURL"
fi
